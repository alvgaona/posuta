---
// The page every poster is drawn on: <html>, <head> and one canvas element, nothing visual.
//
//   <Canvas title="…" description="…" print="A1 landscape" theme="dark">
//     <link slot="head" rel="icon" href="…" />
//     …your poster…
//   </Canvas>
//
// It sets the print page and type scale (base.css + `print`), link-preview tags, and theme
// tokens or a fixed colour scheme. posuta pdf measures the canvas (.posuta-canvas) for overflow;
// in astro dev, ?print on the URL previews the printed page and the same check.
import "./base.css";
import { printCss } from "./print.js";

type Print = string | { size?: string; orientation?: "portrait" | "landscape"; width?: string; height?: string };
interface Props {
  title: string;
  /** For search results and link previews. */
  description?: string;
  /** Paper: "A0", "A1 landscape", { width: "900mm", height: "36in" }… Default A0 portrait. */
  print?: Print;
  /** "light" or "dark" to fix the colour scheme, or tokens such as { accent: "#0a7" }. */
  theme?: "light" | "dark" | Record<string, string>;
  lang?: string;
  class?: string;
  [attr: string]: unknown;
}
const { title, description, print, theme, lang = "en", class: cls, ...rest } = Astro.props;
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const scheme = typeof theme === "string" ? theme : undefined;
// Declared first, so it holds whatever order the stylesheets load in. theme/base/components/
// utilities are Tailwind v4's layers; they are empty without it.
const LAYERS = "@layer theme, base, posuta.base, posuta.theme, components, utilities;";
const tokens = theme && typeof theme === "object"
  ? `:root{${Object.entries(theme).map(([k, v]) => `--${k.replace(/^--/, "")}:${v}`).join(";")}}` : "";
---
<!doctype html>
<html lang={lang} data-theme={scheme}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description}>}
  {pageUrl && <meta property="og:url" content={pageUrl}>}
  {pageUrl && <meta property="og:image" content={new URL("og.png", pageUrl).href}>}
  <meta name="twitter:card" content="summary_large_image">
  <!-- Layer order: resets (Tailwind's base), then posuta, then utilities. Unlayered CSS beats all. -->
  <style is:inline set:html={`${LAYERS}@media print{${printCss(print)}}${tokens}`} />
  <slot name="head" />
</head>
<body>
  <div class:list={["posuta-canvas", cls]} {...rest}><slot /></div>
  {import.meta.env.DEV && <script>
    // astro dev: add ?print to the URL to see the page as it will print, overflow marked.
    // The DEV check here too, so the build drops preview.js instead of emitting it unused.
    if (import.meta.env.DEV && new URLSearchParams(location.search).has("print")) import("./preview.js").then((m) => m.preview());
  </script>}
</body>
</html>
