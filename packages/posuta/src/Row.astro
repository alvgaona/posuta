---
// A row of columns: <Row><Col>…</Col><Col span={2}>…</Col></Row>.
// On screen it reflows by width (three → two → one); in print it keeps the columns as written.
// Any other attribute (class, id, style, data-*) goes on the element.
const { class: cls, ...rest } = Astro.props;
---
<div class:list={["posuta-row", cls]} {...rest}><slot /></div>
