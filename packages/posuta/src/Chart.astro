---
// An Observable Plot chart, drawn to SVG at build time (prints as vectors, works without JS).
//
//   <Chart data="step.csv" plot="step" alt="…" />          charts/step.js: export default (d, Plot, state) => options
//   <Chart … interactive />                                   tooltip and crosshair in the browser
//   <Chart … slider={{ name: "t", min: 0, max: 5, step: 0.1, value: 1, label: "Time" }} />
//
// `plot` may also be an inline function, (d, Plot) => options, for a static chart.
// The slider's `value` is the state the chart prints in.
import * as Plot from "@observablehq/plot";
import { load } from "./data.js";
import { renderPlot } from "./plot.js";

type ChartFn = (data: any[], plot: typeof Plot, state: Record<string, number>) => Plot.PlotOptions;
interface Slider { name: string; min: number; max: number; step?: number; value: number; label?: string }
interface Props {
  /** A file under data/, or the rows themselves. */
  data?: string | object[];
  /** A chart file name in charts/ (without .js), or an inline function for a static chart. */
  plot: string | ChartFn;
  /** What the chart shows, for screen readers. Required. */
  alt: string;
  caption?: string;
  /** Thin series longer than this (rows). */
  max?: number;
  /** Tooltip and crosshair in the browser. */
  interactive?: boolean;
  /** A range input that feeds `state[name]` to the chart function. */
  slider?: Slider;
}
const { data = [], plot, alt, caption, max, interactive = false, slider } = Astro.props;
if (!alt) throw new Error("posuta <Chart>: `alt` is required (what the chart shows, for screen readers)");
const live = interactive || !!slider;
if (live && typeof plot !== "string") {
  throw new Error('posuta <Chart>: an interactive chart or one with a slider needs its chart in a file: plot="name" for charts/name.js');
}
let chart: ChartFn;
if (typeof plot === "string") {
  const files = import.meta.glob<{ default: ChartFn }>("/charts/*.js");
  const file = files[`/charts/${plot}.js`];
  if (!file) throw new Error(`posuta <Chart>: no charts/${plot}.js (found: ${Object.keys(files).join(", ") || "none"})`);
  chart = (await file()).default;
} else chart = plot;
const rows = typeof data === "string" ? await load(data, { max }) : data;
const state = slider ? { [slider.name]: slider.value } : {};
const svg = renderPlot({ ariaLabel: alt, ...chart(rows, Plot, state) });
---
<figure class="posuta-figure posuta-chart" data-chart={live ? plot : undefined} data-alt={live ? alt : undefined}
  data-interactive={interactive || undefined} data-slider={slider && JSON.stringify(slider)}>
  {slider && (
    <label class="posuta-slider" hidden>
      <span>{slider.label ?? slider.name}</span>
      <input type="range" min={slider.min} max={slider.max} step={slider.step ?? 1} value={slider.value} />
      <output>{slider.value}</output>
    </label>
  )}
  <div class="posuta-plot"><Fragment set:html={svg} /></div>
  {live && <script type="application/json" set:html={JSON.stringify(rows)} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
{live && <script>import "./chart-client.js";</script>}
