---
// A display equation, rendered with KaTeX at build time: <Equation tex="E = mc^2" n={1} />
// (Inline math is plain $…$ in the text.)
import katex from "katex";
interface Props { tex: string; n?: number | string; class?: string; [attr: string]: unknown }
const { tex, n, class: cls, ...rest } = Astro.props;
const html = katex.renderToString(tex, { displayMode: true, throwOnError: true, strict: "error" });
---
<div class:list={["posuta-eq", cls]} {...rest}><Fragment set:html={html} />{n != null && <span class="posuta-eq-n">({n})</span>}</div>
