---
// A cell in <Grid>. `span`: columns it covers (default 1); `rows`: rows it covers (default 1).
interface Props { span?: number; rows?: number; class?: string; [attr: string]: unknown }
const { span = 1, rows = 1, class: cls, style, ...rest } = Astro.props;
---
<div class:list={["posuta-cell", cls]} style={[`--span:${span};--rows:${rows}`, style].filter(Boolean).join(";")} {...rest}><slot /></div>
