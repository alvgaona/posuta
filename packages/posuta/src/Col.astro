---
// A column inside <Row>. `span` is its width relative to its siblings (default 1).
interface Props { span?: number; class?: string; [attr: string]: unknown }
const { span = 1, class: cls, style, ...rest } = Astro.props;
---
<div class:list={["posuta-col", cls]} style={[`--span:${span}`, style].filter(Boolean).join(";")} {...rest}><slot /></div>
