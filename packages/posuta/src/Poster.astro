---
// Page layout for a poster. Used from MDX frontmatter: `layout: posuta/Poster.astro`.
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-serif/500.css";
import "@fontsource/ibm-plex-serif/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "./theme.css";
import { printCss } from "./print.js";

interface Stat { value: string; label: string; accent?: boolean }
interface Frontmatter {
  title: string; highlight?: string; eyebrow?: string; lede?: string; stats?: Stat[]; footer?: string;
  print?: string | { size?: string; orientation?: "portrait" | "landscape"; width?: string; height?: string };
}
const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const { title, highlight, eyebrow, lede, stats = [], footer, print } = frontmatter;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}{highlight ? ` ${highlight}` : ""}</title>
  <style is:inline set:html={`@media print{${printCss(print)}}`} />
</head>
<body>
  <div class="poster">
    <header class="hero">
      <div>
        {eyebrow && <div class="eyebrow">{eyebrow}</div>}
        <h1>{title}{highlight && <> <em>{highlight}</em></>}</h1>
        {lede && <p class="lede">{lede}</p>}
      </div>
      {stats.length > 0 && (
        <div class="stats">
          {stats.map((s) => <div class="stat"><b class:list={{ acc: s.accent }}>{s.value}</b><span>{s.label}</span></div>)}
        </div>
      )}
    </header>
    <main><slot /></main>
    {footer && <footer><span>{footer}</span></footer>}
  </div>
</body>
</html>
