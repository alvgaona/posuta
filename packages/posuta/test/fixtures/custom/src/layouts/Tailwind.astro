---
// posuta's theme and Tailwind together: Tailwind's reset sits under posuta, its utilities over it.
import Canvas from "posuta/Canvas.astro";
import "posuta/theme.css";
import "../styles/tailwind.css";
const { frontmatter: fm } = Astro.props;
---
<Canvas title={fm.title} print={fm.print} class="p-8">
  <h1 class="text-5xl">{fm.title}</h1>
  <slot />
</Canvas>
