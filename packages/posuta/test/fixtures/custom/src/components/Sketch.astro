---
// A hand-drawn SVG with posuta's maths labels.
import { texSvg } from "@posuta/posuta/tex";
const a = { x: 10, y: 20, w: 120, h: 50 }, b = { x: 220, y: 90, w: 120, h: 50 };
const pts = [[a.x + a.w, a.y + a.h / 2], [a.x + a.w + 45, a.y + a.h / 2], [a.x + a.w + 45, b.y + b.h / 2], [b.x, b.y + b.h / 2]];
---
<svg viewBox="0 0 360 160" font-size="16" role="img" aria-label="Two states joined by a transition">
  <defs>
    <marker id="sk-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0,1 L10,5 L0,9 z" fill="context-stroke" />
    </marker>
  </defs>
  {[a, b].map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} rx="25" fill="none" stroke="currentColor" />)}
  <path d={"M" + pts.map((p) => p.join(",")).join(" L")} fill="none" stroke="#0b7a55" stroke-width="2" marker-end="url(#sk-head)" />
  <Fragment set:html={texSvg("$x_k$", a.x + a.w / 2, a.y + 31, { anchor: "middle" })} />
  <Fragment set:html={texSvg("$x_{k+1}$", b.x + b.w / 2, b.y + 31, { anchor: "middle" })} />
</svg>
