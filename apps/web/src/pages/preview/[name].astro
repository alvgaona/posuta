---
// A real posuta component on its own page, embedded in the docs by <Preview name="…" />.
// Kept apart from the docs page, which React renders and which can't hold Astro components.
// Every example's <style is:global> lands on every preview page: scope it with [data-preview="name"].
// Unlike MDX, .astro attribute strings read \f \r \t \n \b \v as escapes: avoid \frac, \right… in them.
import 'posuta/base.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';

const previews = import.meta.glob<{ default: any }>('/src/previews/*.astro', { eager: true });

export function getStaticPaths() {
  return Object.keys(import.meta.glob('/src/previews/*.astro')).map((path) => ({
    params: { name: path.split('/').pop()!.replace('.astro', '') },
  }));
}

const Example = previews[`/src/previews/${Astro.params.name}.astro`].default;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      // follow the docs' light/dark switch
      const sync = () => document.documentElement.classList.toggle('dark', parent.document.documentElement.classList.contains('dark'));
      sync();
      new MutationObserver(sync).observe(parent.document.documentElement, { attributes: true, attributeFilter: ['class'] });
    </script>
  </head>
  <body data-preview={Astro.params.name}>
    <Example />
    <script is:inline>
      // fit the docs page's iframe to this example
      new ResizeObserver(() => { if (frameElement) frameElement.style.height = `${document.body.scrollHeight}px`; }).observe(document.body);
    </script>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; --fg: #0a0a0a; --muted: #666; --line: #e5e5e5; --box: #f5f5f5; }
  :root.dark { color-scheme: dark; --fg: #fafafa; --muted: #a1a1a1; --line: #1f1f1f; --box: #0f0f0f; }
  html { background: transparent; color: var(--fg); font: 16px/1.5 'Geist Variable', sans-serif; }
  /* a stage: the example centred, like a component on shadcn */
  body { margin: 0; padding: 2.5rem 2rem; min-height: 14rem; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  body > :not(.posuta-qr) { width: 100%; max-width: 46rem; }
  astro-dev-toolbar { display: none; }
  figure { margin: 0; }
  figcaption { margin-top: 0.75rem; font-size: 0.8125rem; color: var(--muted); }
  /* charts at their drawn size, never wider than the stage; only Plot's own SVG, not the legend swatches */
  .posuta-plot > svg, .posuta-plot > figure > svg { display: block; max-width: 100%; height: auto; }
  .posuta-plot { font-family: 'Geist Variable', sans-serif; }
  .posuta-plot figure { margin: 0; }
  .posuta-slider:not([hidden]) { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; font: 0.8125rem 'Geist Mono Variable', monospace; color: var(--muted); }
  .posuta-slider input { flex: 1; accent-color: var(--fg); }
  .posuta-slider output { color: var(--fg); min-width: 3ch; text-align: end; }
  .posuta-eq { display: flex; align-items: center; justify-content: center; gap: 2rem; font-size: 1.25rem; }
  .posuta-eq-n { color: var(--muted); font-size: 1rem; }
  /* pictures at a readable size, centred */
  .posuta-figure:not(.posuta-chart) { max-width: 30rem; }
  img, video, svg.posuta-media { display: block; max-width: 100%; height: auto; margin-inline: auto; }
  svg.posuta-media { color: var(--fg); }
  /* a QR code needs a light margin around it to scan, on a dark page too */
  :where(.posuta-qr) { width: 9rem; height: auto; }
  .posuta-qr { padding: 0.5rem; background: #fff; }
  .posuta-refs { margin: 0; padding-left: 1.5rem; font-size: 0.875rem; }
  .posuta-refs a { color: inherit; }
  .posuta-tip { padding: 0.375rem 0.5rem; background: var(--box); border: 1px solid var(--line); font-size: 0.75rem; }
  .box { margin: 0 0 1rem; padding: 1.5rem 1rem; background: var(--box); border: 1px solid var(--line); font: 0.8125rem 'Geist Mono Variable', monospace; text-align: center; color: var(--muted); }
</style>
