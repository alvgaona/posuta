---
// This poster's layout: the header, the footer and the QR code. It is yours to change: posuta
// only provides <Canvas> (print size, link previews); the look is ../styles/theme.css.
// Pages use it from frontmatter: `layout: ../layouts/Poster.astro`. The lede, stat labels and
// footer take inline Markdown: **bold**, [links](…), $maths$ and [@key] citations.
import Canvas from "posuta/Canvas.astro";
import { md } from "posuta/md";
import QR from "posuta/QR.astro";
import "../styles/theme.css";

interface Stat { value: string; label: string; accent?: boolean }
interface Frontmatter {
  title: string; highlight?: string; eyebrow?: string; lede?: string; stats?: Stat[]; footer?: string;
  print?: string | { size?: string; orientation?: "portrait" | "landscape"; width?: string; height?: string; scale?: number };
  /** The QR code on the printed poster: a URL, or false. Defaults to this page's URL when `site` is set. */
  qr?: string | false;
  /** "light" or "dark" to fix the colour scheme, or tokens such as { accent: "#0a7" }. */
  theme?: "light" | "dark" | Record<string, string>;
  /** Set by posuta from the citations: the numbers md() gives [@key]. */
  references?: { key: string; n: number }[];
}
const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const { title, highlight, eyebrow, lede, stats = [], footer, print, theme } = frontmatter;
const html = (s?: string) => md(s, frontmatter.references);
const [ledeHtml, footerHtml, ...labels] = await Promise.all([html(lede), html(footer), ...stats.map((s) => html(s.label))]);
const description = lede?.replace(/\s*\[@[^\]]*\]/g, ""); // link previews show plain text
const qrUrl = frontmatter.qr === false ? undefined : frontmatter.qr ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined);
---
<Canvas title={`${title}${highlight ? ` ${highlight}` : ""}`} description={description} print={print} theme={theme}>
  <header class="hero" data-name="the title block">
    <div>
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      <h1>{title}{highlight && <> <em>{highlight}</em></>}</h1>
      {lede && <p class="lede" set:html={ledeHtml} />}
    </div>
    {stats.length > 0 && (
      <div class="stats">
        {stats.map((s, i) => <div class="stat"><b class:list={{ acc: s.accent }}>{s.value}</b><span set:html={labels[i]} /></div>)}
      </div>
    )}
  </header>
  <main><slot /></main>
  {(footer || qrUrl) && (
    <footer data-name="the footer">
      <span set:html={footerHtml} />
      {qrUrl && <a class="qr" data-print="only" href={qrUrl}><QR url={qrUrl} /><span>{qrUrl.replace(/^https?:\/\//, "")}</span></a>}
    </footer>
  )}
</Canvas>
